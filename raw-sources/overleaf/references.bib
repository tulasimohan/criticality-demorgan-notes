@article{patersonShrinkageMorganFormulae1993,
  title = {Shrinkage of de {{Morgan}} Formulae under Restriction},
  author = {Paterson, Michael S. and Zwick, Uri},
  year = {1993},
  journal = {Random Structures \& Algorithms},
  volume = {4},
  number = {2},
  pages = {135--150},
  issn = {1098-2418},
  doi = {10.1002/rsa.3240040203},
  urldate = {2024-12-25},
  abstract = {It is shown that a random restriction leaving only a fraction {$\epsilon$} of the input variables unassigned reduces the expected de Morgan formula size of the induced function by a factor of O(E(5-{\textsurd}2)/2) = O({$\epsilon$}1.63). (A de Morgan, or unate, formula is a formula over the basis {$\wedge$}, {$\vee$}, {\textlnot}.) This improves a long-standing result of O({$\epsilon$}1.5) by Subbotovskaya and a recent improvement to O({$\epsilon$}(21-{\textsurd}73)/8) = O({$\epsilon$}1.55) by Nisan and Impagliazzo. The New exponent yields an increased lower bound of n(7-{\textsurd}3)/2-o(1) = {\textohm}(n2.63) for the de Morgan formula size of a function in P defined by Andreev. This is the largest formula size lower bound known, even for functions in NP. {\copyright} 1993 John Wiley \& Sons, Inc.},
  copyright = {Copyright {\copyright} 1993 Wiley Periodicals, Inc., A Wiley Company},
  langid = {english},
  file = {/Users/tulasi/Zotero/storage/EE39M5YA/Paterson and Zwick - 1993 - Shrinkage of de Morgan formulae under restriction.pdf;/Users/tulasi/Zotero/storage/V8YL5FNE/rsa.html}
}

