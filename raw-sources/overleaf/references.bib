@article{impagliazzoEffectRandomRestrictions1993,
  title = {The Effect of Random Restrictions on Formula Size},
  author = {Impagliazzo, Russell and Nisan, Noam},
  year = {1993},
  journal = {Random Structures \& Algorithms},
  volume = {4},
  number = {2},
  pages = {121--133},
  issn = {1098-2418},
  doi = {10.1002/rsa.3240040202},
  urldate = {2024-12-25},
  abstract = {We consider the formula size complexity of boolean functions over the base consisting of {$\wedge$}, {$\vee$}, and {\textlnot} gates. In 1961 Subbotovskaya proved that, for any boolean function on n variables, setting all but a randomly chosen {$\epsilon$}n variables to randomly chosen constants, reduces the expected complexity of the induced function by at least a factor. This fact was used by Subbotovskaya to derive a lower bound of {\textohm}(n1.5) for the formula size of the parity function, and more recently by Andreev who exhibited at lower bound of {\textohm}C(n2.5/logO(1)(n)) for a function in P. We present the first improvement of Subbotovskaya's result, showing that the expected formual complexity of a function restricted as above is at most an O({$\epsilon\gamma$}) franction of its original complexity, for This allows us to give an improved lower bound of {\textohm}(n2.556{\dots}) for Andreev's function. At the time of discovery, this was the best formula lower bound known for any function in NP. {\copyright} 1993 John Wiley \& Sons, Inc.},
  copyright = {Copyright {\copyright} 1993 Wiley Periodicals, Inc., A Wiley Company},
  langid = {english}
}

